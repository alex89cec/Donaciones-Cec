rules_version = '2';

// Reglas de seguridad de Firestore para el sitio del club.
// Pegá TODO esto en: Firebase → Firestore Database → pestaña "Reglas".
//
// El email admin del proyecto es amedinar89@gmail.com (el mismo que usás para
// loguearte en Authentication → Users). Ya está puesto abajo.

service cloud.firestore {
  match /databases/{database}/documents {

    // Contenido y meta: lectura pública, escritura solo tuya.
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "amedinar89@gmail.com";
    }
    match /mejoras/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "amedinar89@gmail.com";
    }

    // Donaciones (nombre + mensaje + monto):
    match /donaciones/{doc} {
      // Cualquiera puede DEJAR una donación, pero siempre entra como "pendiente"
      // (nadie puede autoconfirmarse ni saltarse la moderación).
      allow create: if request.resource.data.estado == "pendiente"
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 40
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 200
        && request.resource.data.monto is number
        && request.resource.data.monto >= 0
        && request.resource.data.monto <= 100000000;

      // El público solo LEE las confirmadas (muro y overlay).
      // Vos (admin) leés todas.
      allow read: if resource.data.estado == "confirmada"
        || (request.auth != null && request.auth.token.email == "amedinar89@gmail.com");

      // Solo vos confirmás / ocultás / borrás.
      allow update, delete: if request.auth != null
        && request.auth.token.email == "amedinar89@gmail.com";
    }
  }
}
